					"script": {
						"exec": [
							"pm.test(\"Create order with delay\", function (done) {",
							"",
							"    const json = pm.response.json();",
							"",
							"    pm.expect(pm.response.code).to.eql(200);",
							"",
							"    pm.expect(json.status).to.eql(\"IN_PROCESS\");",
							"",
							"    pm.environment.set(\"orderId\", json.orderId);",
							"",
							"    setTimeout(function () {",
							"        done();",
							"    }, 1000);",
							"});"
